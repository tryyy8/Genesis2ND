<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#080D16"
                android:centerColor="#101B29"
                android:endColor="#070B12" />
        </shape>
    </item>
    <item android:width="420dp" android:height="420dp" android:gravity="top|right">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="270dp"
                android:centerX="0.62"
                android:centerY="0.34"
                android:startColor="#244B7180"
                android:endColor="#004B7180" />
        </shape>
    </item>
    <item android:width="360dp" android:height="360dp" android:gravity="bottom|left">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:centerX="0.42"
                android:centerY="0.58"
                android:startColor="#1B416C70"
                android:endColor="#00416C70" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#08FFFFFF" />
        </shape>
    </item>
</layer-list>
