<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:label="Genesis"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Genesis"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".GenesisAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/genesis_accessibility_service" />
        </service>
        <service
            android:name=".IsolatedGuestComputeService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":genesis_guest_isolated" />
        <service
            android:name=".AndroidGuestBridgeService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started authenticated loopback bridge forwarding bounded WebAssembly requests to the OS-isolated Genesis guest process" />
        </service>
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".WorkerRuntimeService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started Genesis distributed compute worker processing bounded jobs from the user's own headquarters device" />
        </service>
        <service
            android:name=".AndroidBuildSigningBridgeService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-authorized Phone A APK signing and verification using the device-bound AndroidKeyStore identity" />
        </service>
    </application>
</manifest>